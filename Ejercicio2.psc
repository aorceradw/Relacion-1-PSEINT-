Algoritmo Ejercicio2
	//Angela Orcera Ruiz 1ºDAW
	//Pido la base y la altura y calculo el area y el perimetro
	//Datos de entrada
	//Hago el area multiplicando y el perimetro sumando los lados
	Definir base, altura, area, perimetro Como Real
	//Pido por teclado
	Leer base, altura
	area <- base * altura
	perimetro <- 2 * (base + altura)
	Escribir area, perimetro
FinAlgoritmo
