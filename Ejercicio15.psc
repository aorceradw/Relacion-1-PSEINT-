Algoritmo Ejercicio15
	//Angela Orcera Ruiz 1ºDAW
	//Intercambio los valores usando una variable auxiliar
	//Datos de entrada
	//Uso una variable auxiliar para no perder el primer numero
	Definir a, b, auxiliar Como Real
	//Pido por teclado
	Leer a, b
	auxiliar <- a
	a <- b
	b <- auxiliar
	Escribir a, b
FinAlgoritmo
