Algoritmo Ejercicio13
	//Angela Orcera Ruiz 1ºDAW
	//Calculo la raiz cuadrada y la raiz cubica
	//Datos de entrada
	//Uso RC para la raiz cuadrada y una potencia para la cubica
	Definir n, cuadrada, cubica Como Real
	//Pido por teclado
	Leer n
	cuadrada <- RC(n)
	cubica <- n^(1/3)
	Escribir cuadrada, cubica
FinAlgoritmo
