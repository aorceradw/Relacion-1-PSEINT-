Algoritmo Ejercicio12
	//Angela Orcera Ruiz 1ºDAW
	//Calculo la distancia entre dos puntos
	//Datos de entrada
	//Saco la diferencia de las coordenadas y aplico la formula
	Definir x1, y1, x2, y2, d Como Real
	//Pido por teclado
	Leer x1, y1, x2, y2
	d <- RC((x2-x1)^2 + (y2-y1)^2)
	Escribir d
FinAlgoritmo
